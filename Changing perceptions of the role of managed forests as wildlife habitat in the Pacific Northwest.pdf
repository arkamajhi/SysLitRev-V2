      <rdf:Description rdf:about=""
            xmlns:dc="http://purl.org/dc/elements/1.1/">
         <dc:format>application/pdf</dc:format>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Manageing for Wildlife Habitat in Westside Production Forests</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Bag>
               <rdf:li>Techinical Editors: Timothy B. Harrington and Gretchen E. Nicholas</rdf:li>
            </rdf:Bag>
         </dc:creator>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Topics include a history of wildlife management research in the Pacific Northwest, elements of habitat and how to manage for them, the challenges of appropriately implementing ecosystem management, and economic implications to private forestland owners.</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:subject>
            <rdf:Bag>
               <rdf:li>Wildlife habitat</rdf:li>
               <rdf:li>old-forest structure</rdf:li>
               <rdf:li>thinning</rdf:li>
               <rdf:li>coarse woody debris</rdf:li>
               <rdf:li>wildlife trees</rdf:li>
               <rdf:li>management regimes</rdf:li>
               <rdf:li>economic analysis.</rdf:li>
            </rdf:Bag>
         </dc:subject>
      </rdf:Description>
